001b[38:2:69:71:91m  4 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  5 \u001b(B\u001b[m\u001b[38:2:203:166:248mauto\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:180:251mmain\u001b(B\u001b[m\u001b[38:2:147:153:179m()\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:220:236m->\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mint\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m{\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  6 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[38:2:137:180:251mf\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:250:179:136m42\u001b(B\u001b[m\u001b[38:2:147:153:179m);\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  7 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[38:2:203:166:248mreturn\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:250:179:136mEXIT_SUCCESS\u001b(B\u001b[m\u001b[38:2:147:153:179m;\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  8 \u001b(B\u001b[m\u001b[38:2:147:153:179m}\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:30:30:47m~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n~\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m threads.cpp                             cpp \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 75%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑: 6/8≡\u001b[14;80H℅\u001b[14;81H:6\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:25