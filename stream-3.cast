[0.011, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:81:154:186m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mbanque.cpp    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b[1;25H\u001b(B\u001b[m\u001b[38:2:205:214:245m                                                           \r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 14 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 15 \u001b(B\u001b[m\u001b[38:2:205:214:245m  auto transfert(std::shared_ptr<Compte> other, int amount) {\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 16 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::lock_guard<std::mutex> lock(m_), lock_other(other->m_);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 17 \u001b(B\u001b[m\u001b[38:2:205:214:245m    amount_ -= amount;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 18 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::cout << owner_ << \": \" << amount_ << std::endl;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 19 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 20 \u001b(B\u001b[m\u001b[38:2:205:214:245m    // std::lock_guard<std::mutex> lock_other(other->m_);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 21 \u001b(B\u001b[m\u001b[38:2:205:214:245m    other->amount_ += amount;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 22 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::cout << other->owner_ << \": \" << other->amount_ << std::endl;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 23 \u001b(B\u001b[m\u001b[38:2:205:214:245m  }\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 24 \u001b(B\u001b[m\u001b[38:2:205:214:245m};\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 25 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m banque.cpp                            cpp \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 51%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑:20/39≡\u001b[14;79H℅\u001b[14;80H:54\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:205:214:245m\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:81:154:186m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mbanque.cpp    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[1;25H\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 14 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 15 \u001b(B\u001b[m\u001b[38:2:205:214:245m  auto transfert(std::shared_ptr<Compte> other, int amount) {\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 16 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::lock_guard<std::mutex> lock(m_), lock_other(other->m_);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 17 \u001b(B\u001b[m\u001b[38:2:205:214:245m    amount_ -= amount;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 18 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::cout << owner_ << \": \" << amount_ << std::endl;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 19 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 20 \u001b(B\u001b[m\u001b[38:2:205:214:245m    // std::lock_guard<std::mutex> lock_other(other->m_);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 21 \u001b(B\u001b[m\u001b[38:2:205:214:245m    other->amount_ += amount;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 22 \u001b(B\u001b[m\u001b[38:2:205:214:245m    std::cout << other->owner_ << \": \" << other->amount_ << std::endl;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 23 \u001b(B\u001b[m\u001b[38:2:205:214:245m  }\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 24 \u001b(B\u001b[m\u001b[38:2:205:214:245m};\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 25 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m banque.cpp                            cpp \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 51%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑:20/39≡\u001b[14;79H℅\u001b[14;80H:54\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:205:214:245m\r\n\u001b[J\u001b[8;58H\u001b[?2026l"]
[0.009, "o", "\u001b[?2026h\u001b[3;7H\u001b(B\u001b[m\u001b[38:2:203:166:248mauto\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:180:251mtransfert\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mstd\u001b(B\u001b[m\u001b[38:2:147:153:179m::\u001b(B\u001b[m\u001b[38:2:249:226:176mshared_ptr\u001b(B\u001b[m\u001b[38:2:147:153:179m<\u001b(B\u001b[m\u001b[38:2:249:226:176mCompte\u001b(B\u001b[m\u001b[38:2:147:153:179m>\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:235:160:173mother\u001b(B\u001b[m\u001b[38:2:147:153:179m,\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mint\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:235:160:173mamount\u001b(B\u001b[m\u001b[38:2:147:153:179m)\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m{\u001b[4;9H\u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mstd\u001b(B\u001b[m\u001b[38:2:147:153:179m::\u001b(B\u001b[m\u001b[38:2:249:226:176mlock_guard\u001b(B\u001b[m\u001b[38:2:147:153:179m<\u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mstd\u001b(B\u001b[m\u001b[38:2:147:153:179m::\u001b(B\u001b[m\u001b[38:2:249:226:176mmutex\u001b(B\u001b[m\u001b[38:2:147:153:179m>\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:180:251mlock\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:249:226:176mm_\u001b(B\u001b[m\u001b[38:2:147:153:179m),\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:205:214:245mlock_other\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:205:214:245mother\u001b(B\u001b[m\u001b[38:2:137:220:236m->\u001b(B\u001b[m\u001b[38:2:180:190:255mm_\u001b(B\u001b[m\u001b[38:2:147:153:179m);\u001b[5;9H\u001b(B\u001b[m\u001b[38:2:205:214:245mamount_\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:220:236m-=\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[