[0.011, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:81:154:186m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mopenmp.cpp    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b[1;25H\u001b(B\u001b[m\u001b[38:2:205:214:245m                                                           \r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 19 \u001b(B\u001b[m\u001b[38:2:205:214:245m  //\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 20 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const int N = 1000000000;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 21 \u001b(B\u001b[m\u001b[38:2:205:214:245m  std::vector<int> v(N, 0);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 22 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 23 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const auto start = std::chrono::steady_clock::now();\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 24 \u001b(B\u001b[m\u001b[38:2:205:214:245m#pragma omp parallel\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 25 \u001b(B\u001b[m\u001b[38:2:205:214:245m  for (int i{0}; i < N; i++) {\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 26 \u001b(B\u001b[m\u001b[38:2:205:214:245m    v[i] = i * i;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 27 \u001b(B\u001b[m\u001b[38:2:205:214:245m  }\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 28 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const auto end = std::chrono::steady_clock::now();\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 29 \u001b(B\u001b[m\u001b[38:2:205:214:245m  std::cout << \"temps é\u001b[12;28Hcoulé\u001b[12;33H: \" << (end - start).count() / 1000000000.\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 30 \u001b(B\u001b[m\u001b[38:2:205:214:245m            << std::endl;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m openmp.cpp                             cpp \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 72%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑:24/33≡\u001b[14;80H℅\u001b[14;81H:1\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:205:214:245m\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:81:154:186m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mopenmp.cpp    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[1;25H\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 19 \u001b(B\u001b[m\u001b[38:2:205:214:245m  //\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 20 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const int N = 1000000000;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 21 \u001b(B\u001b[m\u001b[38:2:205:214:245m  std::vector<int> v(N, 0);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 22 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 23 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const auto start = std::chrono::steady_clock::now();\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 24 \u001b(B\u001b[m\u001b[38:2:205:214:245m#pragma omp parallel\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 25 \u001b(B\u001b[m\u001b[38:2:205:214:245m  for (int i{0}; i < N; i++) {\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 26 \u001b(B\u001b[m\u001b[38:2:205:214:245m    v[i] = i * i;\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 27 \u001b(B\u001b[m\u001b[38:2:205:214:245m  }\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 28 \u001b(B\u001b[m\u001b[38:2:205:214:245m  const