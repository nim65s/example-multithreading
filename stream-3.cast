[0.027, "o", "\u001b[01m\u001b[Kopenmp.cpp:\u001b[m\u001b[K In function « \u001b[01m\u001b[Kint\u001b[01;32m\u001b[K main\u001b[m\u001b[K()\u001b[m\u001b[K »:\r\n\u001b[01m\u001b[Kopenmp.cpp:5:10:\u001b[m\u001b[K \u001b[01;31m\u001b[Kerreur: \u001b[m\u001b[K« \u001b[01m\u001b[Kstring\u001b[m\u001b[K » n'est pas un membre de « \u001b[01m\u001b[Kstd\u001b[m\u001b[K »\r\n    5 |     std::\u001b[01;31m\u001b[Kstring\u001b[m\u001b[K r = \"hello \";\r\n      |          \u001b[01;31m\u001b[K^~~~~~\u001b[m\u001b[K\r\n\u001b[01m\u001b[Kopenmp.cpp:2:1:\u001b[m\u001b[K \u001b[01;36m\u001b[Knote: \u001b[m\u001b[K« \u001b[01m\u001b[Kstd::string\u001b[m\u001b[K » est défini dans l'en-tête « \u001b[01m\u001b[K<string>\u001b[m\u001b[K » ; cela peut probablement être corrigé en ajoutant « \u001b[01m\u001b[K#include <string>\u001b[m\u001b[K »\r\n    1 | #include <omp.h>\r\n  +++ |+\u001b[32m\u001b[K#include <string>\u001b[m\u001b[K\r\n    2 | \r\n"]
