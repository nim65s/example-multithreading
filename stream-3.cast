:236m++\u001b(B\u001b[m\u001b[38:2:147:153:179m)\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m{\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 15 \u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:205:214:245mthreads\u001b(B\u001b[m\u001b[38:2:147:153:179m.\u001b(B\u001b[m\u001b[38:2:137:180:251mpush_back\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:205:214:245mf\u001b(B\u001b[m\u001b[38:2:147:153:179m);\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 16 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[38:2:147:153:179m}\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 17 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 18 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[38:2:203:166:248mfor\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:203:166:248mauto\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:220:236m&\u001b(B\u001b[m\u001b[38:2:205:214:245mt\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m:\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:205:214:245mthreads\u001b(B\u001b[m\u001b[38:2:147:153:179m)\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m{\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 19 \u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:205:214:245mt\u001b(B\u001b[m\u001b[38:2:147:153:179m.\u001b(B\u001b[m\u001b[38:2:137:180:251mjoin\u001b(B\u001b[m\u001b[38:2:147:153:179m();\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 20 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[38:2:147:153:179m};