[0.008, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:81:154:186m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mopenmp.cpp    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b[1;25H\u001b(B\u001b[m\u001b[38:2:205:214:245m                                                           \r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  1 \u001b(B\u001b[m\u001b[38:2:249:226:176m#include\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:166:227:162m<iostream>\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  2 \u001b(B\u001b[m\u001b[38:2:249:226:176m#include\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:166:227:162m<omp.h>\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  3 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  4 \u001b(B\u001b[m\u001b[38:2:203:166:248mauto\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:180:251mmain\u001b(B\u001b[m\u001b[38:2:147:153:179m()\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:220:236m->\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mint\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:147:153:179m{\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  5 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  6 \u001b(B\u001b[m\u001b[38:2:245:194:232m#pragma\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:249:226:176momp\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:205:214:245mparallel\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  7 \u001b(B\u001b[m\u001b[38:2:205:214:245m  \u001b(B\u001b[m\u001b[3