[0.007, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:241:76:40m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mCOMMIT_EDITMSG    \u001b[1;27H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b[1;29H\u001b(B\u001b[m\u001b[38:2:205:214:245m                                                       \r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  1 \u001b(B\u001b[m\u001b[38:2:137:180:251mRevert \"[pre-commit.ci] pre-commit autoupdate\"\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  2 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  3 \u001b(B\u001b[m\u001b[38:2:205:214:245mThis reverts commit 0ae9bfcc25e985de5ef4a7cf9224e1e309c2ca0b.\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  4 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  5 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# Veuillez saisir le message de validation pour vos modifications. Les lignes\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  6 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# commençant par '#' seront ignoré\u001b[7;39Hes, et un message vide abandonne la validatio\u001b(B\u001b[m\u001b[38:2:69:71:91m    \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179mn.\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  7 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m#\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  8 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# Sur la branche \u001b(B\u001b[m\u001b[3m\u001b[38:2:180:190:255mmain\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  9 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# Votre branche est à\u001b[11;26H jour avec '\u001b(B\u001b[m\u001b[3m\u001b[38:2:180:190:255morigin/main\u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m'.\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 10 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m#\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 11 \u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# \u001b(B\u001b[m\u001b[3m\u001b[38:2:137:180:251mModifications qui seront validé\u001b[13;38Hes :\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m .git/COMMIT_EDITMSG                    git…\u001b[14;53H \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 3%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑: 1/32≡\u001b[14;80H℅\u001b[14;81H:1\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:205:214:245m\r\n\u001b[J\u001b[2 q\u001b[2;5H\u001b[?2026l"]
