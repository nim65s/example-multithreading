[0.01495, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:255:188:3m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mthreads.py    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b[1;25H\u001b(B\u001b[m\u001b[38:2:205:214:245m                                                                 \r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  2 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  3 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom time import perf_counter\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  4 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom concurrent.futures import ThreadPoolExecutor\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  5 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  6 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom task import task\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  7 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  8 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  9 \u001b(B\u001b[m\u001b[38:2:205:214:245mdef pool(count: int) -> float:\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 10 \u001b(B\u001b[m\u001b[38:2:205:214:245m    # ref. https://docs.python.org/3/library/concurrent.futures.html\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 11 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 12 \u001b(B\u001b[m\u001b[38:2:205:214:245m    start = perf_counter()\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 13 \u001b(B\u001b[m\u001b[38:2:205:214:245m    with ThreadPoolExecutor() as executor:\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 14 \u001b(B\u001b[m\u001b[38:2:205:214:245m        for _ in range(count):\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 15 \u001b(B\u001b[m\u001b[38:2:205:214:245m            executor.submit(task)\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m 16 \u001b(B\u001b[m\u001b[38:2:205:214:245m    end = perf_counter()\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0mNORMAL\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m  ⚙\u001b[17;11H \u001b(B\u001b[m\u001b[38:2:156:255:211m\u001b[48:2:32:32:32m threads.py                              pyt…\u001b[17;57H \u001b(B\u001b[m\u001b[38:2:255:255:255m\u001b[48:2:68:68:68m utf-8[unix] \u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m 52%\u001b(B\u001b[0;1m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m ㏑:13/25≡\u001b[17;85H℅\u001b[17;86H:15\u001b(B\u001b[m\u001b[38:2:0:0:95m\u001b[48:2:223:255:0m \u001b(B\u001b[m\u001b[38:2:205:214:245m\r\n\u001b[J\u001b[2 q\u001b[2 q\u001b[H\u001b(B\u001b[m\u001b[38:2:245:194:232m▎\u001b[1;2H\u001b(B\u001b[m\u001b[38:2:205:214:245m    \u001b(B\u001b[m\u001b[38:2:255:188:3m\u001b[1;7H \u001b(B\u001b[m\u001b[38:2:205:214:245mthreads.py    \u001b[1;23H \u001b(B\u001b[m\u001b[38:2:108:112:135m\u001b[48:2:17:17:28m▎\u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[1;25H\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  2 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  3 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom time import perf_counter\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  4 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom concurrent.futures import ThreadPoolExecutor\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  5 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  6 \u001b(B\u001b[m\u001b[38:2:205:214:245mfrom task import task\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  7 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  8 \u001b(B\u001b[m\u001b[38:2:205:214:245m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:69:71:91m  9 \u00