[0.01567, "o", "\u001b[?2026h\u001b[3;5H\u001b(B\u001b[m\u001b[38:2:203:166:248mfrom\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mtime\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mimport\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:205:214:245mperf_counter\u001b[4;5H\u001b(B\u001b[m\u001b[38:2:203:166:248mfrom\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mconcurrent\u001b(B\u001b[m\u001b[38:2:147:153:179m.\u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mfutures\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mimport\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:249:226:176mThreadPoolExecutor\u001b[6;5H\u001b(B\u001b[m\u001b[38:2:203:166:248mfrom\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[3m\u001b[38:2:249:226:176mtask\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mimport\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:205:214:245mtask\u001b[9;5H\u001b(B\u001b[m\u001b[38:2:203:166:248mdef\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:180:251mpool\u001b(B\u001b[m\u001b[38:2:147:153:179m(\u001b(B\u001b[m\u001b[38:2:235:160:173mcount\u001b(B\u001b[m\u001b[38:2:147:153:179m:\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mint\u001b(B\u001b[m\u001b[38:2:147:153:179m)\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:137:220:236m->\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(B\u001b[m\u001b[38:2:203:166:248mfloat\u001b(B\u001b[m\u001b[38:2:147:153:179m:\u001b[10;9H\u001b(B\u001b[m\u001b[3m\u001b[38:2:147:153:179m# ref. \u001b(B\u001b[0;4m\u001b[3m\u001b[38:2:137:180:251mhttps://docs.python.org/3/library/concurrent.futures.html\u001b[12;9H\u001b(B\u001b[m\u001b[38:2:205:214:245mstart\u001b(B\u001b[m\u001b[38:2:205:214:245m \u001b(