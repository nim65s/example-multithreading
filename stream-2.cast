[0.072032, "o", "\u001b[?2026h\u001b[>1u\u001b(B\u001b[m\u001b[H                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \r\n                                                                                         \u001b[1 q\u001b[?1002h\u001b[?1006h\u001b(B\u001b[m\u001b[H                                                                                         \u001b(B\u001b[m\r\n                                                                                         \u001b(B